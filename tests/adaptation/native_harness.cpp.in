class PressureManager {
public:
    int signed_pressure_result = 0;
    int max_torque_result = 0;
    int signed_pressure_calls = 0;
    int calc_max_torque_for_clutch(GearboxGear, Clutch, int, CoefficientTy) {
        return max_torque_result;
    }
    int p_clutch_with_coef_signed(GearboxGear, Clutch, int, CoefficientTy) {
        ++signed_pressure_calls;
        return signed_pressure_result;
    }
};

int first_order_filter(int, int input, int) { return input; }
float interpolate_float(float raw, float new_min, float new_max,
                        float raw_min, float raw_max, InterpType) {
    if (raw_max < raw_min) {
        std::swap(raw_max, raw_min);
        std::swap(new_max, new_min);
    }
    if (raw <= raw_min) return new_min;
    if (raw >= raw_max) return new_max;
    return new_min + ((new_max - new_min) * (raw - raw_min) / (raw_max - raw_min));
}
namespace ShiftHelpers {
float get_shift_intertia(uint8_t) { return 10.0f; }
}

class TestShiftAlgo {
public:
    explicit TestShiftAlgo(ShiftInterfaceData* data, SensorData* sensors, PressureManager* pressure)
        : sid(data), sd(sensors), pm(pressure) {}
    bool is_release_shift() const { return release_shift; }
    uint8_t adapt_p_map_idx();
    short calc_correction_trq(ShiftStyle style, short momentum);
    void adaptation_step();

    ShiftInterfaceData* sid;
    SensorData* sd;
    PressureManager* pm;
    bool release_shift = false;
    bool upshifting = true;
    int16_t target_turbine_speed = 0;
    int centrifugal_force_on_clutch = 0;
    int p_apply_clutch = 0;
    uint16_t abs_input_trq = 0;
    int16_t first_order_pump_trq_filter = 0;
    int32_t momentum_pid[3] = {0,0,0};
    int32_t pid_sum = 0;
    int32_t abs_sum = 0;
    uint16_t pid_count = 0;
    bool do_fill_time_adaptation = false;
    bool do_fill_pressure_adaptation = false;
    bool do_torque_adaptation = false;
    uint8_t timer_p_adapt = 0;
    uint16_t adapting_trq_limit = 0;
    uint16_t adapting_turbine_spd = 0;
    int adapting_p_adapt_trq = 0;
    uint8_t fill_time_adaptation_stage = 0;
    uint8_t fill_pressure_adaptation_stage = 0;
    uint8_t torque_adaptation_stage = 0;
    uint8_t phase_id = 0;
};

